{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MicYou Tauri Frontend",
  "version": "0.1.0",
  "identifier": "dev.libmicyou.frontend.tauri",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MicYou · Tauri Frontend (libmicyou sidecar)",
        "width": 1200,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}