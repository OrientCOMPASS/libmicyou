{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MicYou Tauri Frontend",
  "version": "0.1.0",
  "identifier": "dev.libmicyou.frontend.tauri",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MicYou · Tauri Frontend (libmicyou sidecar)",
        "width": 640,
        "height": 760,
        "minWidth": 480,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
